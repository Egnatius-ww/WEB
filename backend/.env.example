# Скопируйте в .env: cp .env.example .env
# Порт API-сервера
PORT=3000

# CORS: источники фронтенда через запятую (или * для всех)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Подключение к MySQL (для docker compose хост = mysql, для локальной разработки = 127.0.0.1)
DATABASE_URL=mysql://buildmart:buildmart@mysql:3306/buildmart

# Memcached (для docker compose хост = memcached)
MEMCACHED_HOSTS=memcached:11211

# TTL кэша каталога, секунды (по ТЗ 60–120)
CACHE_TTL=90

# Секрет подписи JWT и время жизни токена
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Учётная запись администратора, создаваемая сидом
ADMIN_EMAIL=admin@buildmart.local
ADMIN_PASSWORD=admin12345

# Пароли MySQL в docker compose
MYSQL_PASSWORD=buildmart
MYSQL_ROOT_PASSWORD=rootsecret
